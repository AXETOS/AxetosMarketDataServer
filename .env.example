POSTGRES_DB=axetos_market_data
POSTGRES_USER=axetos
POSTGRES_PASSWORD=replace-with-a-long-random-password
AXETOS_PORT=8000

AXETOS_AUTH_ENABLED=true
AXETOS_VIEWER_TOKEN=
AXETOS_OPERATOR_TOKEN=
AXETOS_ADMIN_TOKEN=replace-with-a-long-random-admin-token
AXETOS_BRIDGE_TOKEN=replace-with-a-different-long-random-bridge-token

AXETOS_ALERT_WEBHOOK_URL=
AXETOS_ALERT_MIN_SEVERITY=error

# Optional MT5 account password. Configure the provider with this variable name,
# not with the password value itself.
# AXETOS_MT5_OANDA_PASSWORD=replace-me
